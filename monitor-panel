def stops(maxv=100, start=1):
    """0 and the preferred numbers (Renard R10, ISO 3) from start up to maxv, as integers:
    0 1 2 3 4 5 6 8 10 13 16 20 25 32 40 50 63 80 100. Each stop is about a quarter more
    than the one before. The eye and the ear judge by ratio, not by difference, so these
    are equal-looking steps: 5→6 is as visible as 50→63, while 50→51 is nothing."""
    out, decade = {0, maxv}, 1
    while decade <= maxv:
        for m in (1, 1.25, 1.6, 2, 2.5, 3.15, 4, 5, 6.3, 8):
            v = int(m * decade + .5)
            if start <= v <= maxv / 1.12:          # no stop crowding the top one
                out.add(v)
        decade *= 10
    return sorted(out)


def pos_of(level, series):
    """Where a level sits on a series of stops, as a fractional index."""
    level = max(0, min(level, series[-1]))
    hi = next(i for i, v in enumerate(series) if v >= level)
    if series[hi] == level:
        return hi
    return hi - 1 + (level - series[hi - 1]) / (series[hi] - series[hi - 1])


def level_at(pos, series):
    lo = max(0, min(int(pos), len(series) - 1))
    hi = min(lo + 1, len(series) - 1)
    return round(series[lo] + (series[hi] - series[lo]) * (pos - lo))


def notch(pos, direction, series):
    """The next notch from a (possibly in-between) position, direction ±1."""
    target = math.floor(pos + 1e-6) + 1 if direction > 0 else math.ceil(pos - 1e-6) - 1
    return max(0, min(target, len(series) - 1))


class StopScale(Gtk.Scale):
    """A slider whose notches are the stops, evenly spaced: the same travel is the same visible
    change anywhere on the slider, and the low end, where a few percent matter, gets the
    room. Dragging, arrow keys and the scroll wheel always land on a notch. A level that
    came from elsewhere is shown where it really is, between notches. set_target() draws
    one tick above the track: where automatic brightness wants this slider."""

    def __init__(self, maxv=100, start=1, fmt=str):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL)
        self.start, self.fmt, self.stops, self.target = start, fmt, [], None
        self.set_value_pos(Gtk.PositionType.RIGHT)
        self.set_hexpand(True)
        self.get_style_context().add_class("mp-scale")
        self.set_max(maxv)
        self.connect("format-value", lambda _s, pos: self.fmt(level_at(pos, self.stops)))
        self.connect("change-value", self.on_change)

    def set_max(self, maxv):
        maxv = max(int(maxv), 1)
        if self.stops and self.stops[-1] == maxv:
            return
        level = self.get_level() if self.stops else 0
        self.stops = stops(maxv, self.start)
        self.set_range(0, len(self.stops) - 1)
        self.set_increments(1, 2)
        self.draw_marks()
        self.set_level(level)

    def set_target(self, level):
        if level != self.target:
            self.target = level
            self.draw_marks()

    def draw_marks(self):
        self.clear_marks()
        for i in range(len(self.stops)):
            self.add_mark(i, Gtk.PositionType.BOTTOM, None)
        if self.target is not None:
            self.add_mark(pos_of(self.target, self.stops), Gtk.PositionType.TOP, None)

    def get_level(self):
        return level_at(self.get_value(), self.stops)

    def set_level(self, level):
        self.set_value(pos_of(level, self.stops))

    def on_change(self, _scale, scroll, pos):
        now = self.get_value()
        if scroll == Gtk.ScrollType.JUMP:                 # dragging or clicking the trough
            target = max(0, min(round(pos), len(self.stops) - 1))
        elif pos != now:                                  # keys / wheel: the next notch
            target = notch(now, 1 if pos > now else -1, self.stops)
        else:
            return True
        self.set_value(target)
        return True


