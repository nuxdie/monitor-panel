def draw_text(cr, widget, text, x, y, scale=1.0, bold=False, rgba=None, alpha=1.0, align=0.0):
    """Text in the panel's own font. (x, y) is the top edge; align 0 left, .5 centre, 1 right.
    Returns (width, height)."""
    layout = widget.create_pango_layout(text)
    desc = widget.get_pango_context().get_font_description().copy()
    desc.set_size(int(desc.get_size() * scale))
    if bold:
        desc.set_weight(Pango.Weight.SEMIBOLD)
    layout.set_font_description(desc)
    w, h = layout.get_pixel_size()
    fg = rgba or theme_colours(widget)[0]
    cr.set_source_rgba(fg.red, fg.green, fg.blue, alpha)
    cr.move_to(x - w * align, y)
    PangoCairo.show_layout(cr, layout)
    return w, h


class EntryPopover(Gtk.Popover):
    """Popover with a prompt, an entry and a confirm button; on_done(text) when confirmed."""

    def __init__(self, relative_to, prompt, button, on_done, text="", extra=()):
        super().__init__(relative_to=relative_to)
        vb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        vb.set_border_width(8)
        vb.pack_start(dim_label(prompt), False, False, 0)
        row = Gtk.Box(spacing=6)
        self.entry = Gtk.Entry(text=text)
        self.entry.set_width_chars(16)
        ok = Gtk.Button(label=button)
        ok.get_style_context().add_class("mp-ok")
        row.pack_start(self.entry, True, True, 0)
        row.pack_start(ok, False, False, 0)
        vb.pack_start(row, False, False, 0)
        for label, cb in extra:
            b = Gtk.ModelButton(text=label)
            b.connect("clicked", lambda _b, cb=cb: (self.popdown(), cb()))
            vb.pack_start(b, False, False, 0)
        vb.show_all()
        self.add(vb)

        def confirm(*_):
            self.popdown()
            on_done(self.entry.get_text().strip())
        ok.connect("clicked", confirm)
        self.entry.connect("activate", confirm)

    def show(self):
        self.popup()
        self.entry.grab_focus()


class Scrub(Gtk.EventBox):
    """A number you change by dragging it sideways (or scrolling over it): no dialog, no
    field, the consequence shows while you move."""

    def __init__(self, value, on_change, lo=0, hi=100, tip=""):
        super().__init__()
        self.value, self.on_change, self.lo, self.hi = value, on_change, lo, hi
        self.start = None
        self.label = Gtk.Label(label=str(value))
        self.label.get_style_context().add_class("mp-scrub")
        self.add(self.label)
        self.set_tooltip_text(tip + "\nDrag sideways or scroll to change.")
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                        Gdk.EventMask.BUTTON1_MOTION_MASK | Gdk.EventMask.SCROLL_MASK |
                        Gdk.EventMask.SMOOTH_SCROLL_MASK)
        self.connect("button-press-event", self.pressed)
        self.connect("motion-notify-event", self.moved)
        self.connect("button-release-event", lambda *_: setattr(self, "start", None))
        self.connect("scroll-event", self.scrolled)
        set_cursor(self, "ew-resize")

    def show_value(self, value):
        self.value = value
        self.label.set_text(str(value))

    def change(self, value):
        value = max(self.lo, min(self.hi, int(value)))
        if value != self.value:
            self.show_value(value)
            self.on_change(value)

    def pressed(self, _w, event):
        self.start = (event.x_root, self.value)
        return True

    def moved(self, _w, event):
        if self.start:
            self.change(self.start[1] + round((event.x_root - self.start[0]) / 6))
        return True

    def scrolled(self, _w, event):
        step = scroll_step(event)
        if step:
            self.change(self.value + step)
        return True


def scroll_step(event):
    """+1 for scrolling up/away, −1 for down, 0 for nothing worth a step."""
    if event.direction == Gdk.ScrollDirection.UP:
        return 1
    if event.direction == Gdk.ScrollDirection.DOWN:
        return -1
    if event.direction == Gdk.ScrollDirection.SMOOTH:
        _ok, _dx, dy = event.get_scroll_deltas()
        return -1 if dy > .5 else 1 if dy < -.5 else 0
    return 0


class DayCurve(Gtk.DrawingArea):
    """Today's automatic brightness, midnight to midnight. The line is what a clear day
    gives from the sun's height alone, built from the four levels under it; the dot is the
    level the light asks for right now, so a dot under the line is an overcast day. The
    line is smooth because the brightness is: it glides between the four levels instead of
    stepping from one to the next. No frame, grid or legend; hours are on the drawing."""

    H = 58

    def __init__(self, panel):
        super().__init__()
        self.panel = panel
        self.set_size_request(-1, self.H)
        self.connect("draw", self.on_draw)
        self.set_tooltip_text("Automatic brightness through today.\n"
                              "Line: a clear day, from the sun's height. Dot: what the light asks for now.\n"
                              "Change the four numbers below to reshape it.")

    def on_draw(self, w, cr):
        amb = self.panel.config.get("ambient", {})
        lat, lon = amb.get("latitude", DEFAULT_LAT), amb.get("longitude", DEFAULT_LON)
        levels = self.panel.levels()
        fg, sel = theme_colours(w)
        W, H = w.get_allocated_width(), w.get_allocated_height()
        left, right, top, base = 1, W - 1, 6, H - 15
        t = time.localtime()
        midnight = time.mktime((t.tm_year, t.tm_mon, t.tm_mday, 0, 0, 0, 0, 0, -1))
        peak = max(max(levels.values()) * 1.15, 12)
        x = lambda hours: left + (right - left) * hours / 24
        y = lambda level: base - (base - top) * level / peak
        curve = [clear_day_level(solar_elevation(midnight + m * 300, lat, lon), levels) for m in range(289)]

        cr.set_line_width(1)
        cr.set_source_rgba(fg.red, fg.green, fg.blue, .12)       # the floor: screen off
        cr.move_to(left, base + .5)
        cr.line_to(right, base + .5)
        cr.stroke()
        for h in (0, 6, 12, 18, 24):
            draw_text(cr, w, f"{h:02d}", x(h), base + 2, .75, alpha=.4, align=0 if h == 0 else 1 if h == 24 else .5)
        # under the curve: a faint wash, so the day reads as a shape
        cr.move_to(x(0), base)
        for m, level in enumerate(curve):
            cr.line_to(x(m / 12), y(level))
        cr.line_to(x(24), base)
        cr.close_path()
        cr.set_source_rgba(fg.red, fg.green, fg.blue, .05)
        cr.fill()
        cr.set_line_width(1.3)
        cr.set_source_rgba(fg.red, fg.green, fg.blue, .6)
        for m, level in enumerate(curve):
            (cr.line_to if m else cr.move_to)(x(m / 12), y(level))
        cr.stroke()
        # now
        now_h = (time.time() - midnight) / 3600
        level = self.panel.auto_level()
        if level is None:
            level = curve[min(288, int(now_h * 12))]
        cr.set_line_width(1)
        cr.set_source_rgba(sel.red, sel.green, sel.blue, .4)
        cr.move_to(x(now_h) + .5, top - 4)
        cr.line_to(x(now_h) + .5, base)
        cr.stroke()
        cr.set_source_rgba(sel.red, sel.green, sel.blue, 1)
        cr.arc(x(now_h) + .5, y(level), 3.4, 0, 2 * math.pi)
        cr.fill()


class ToneCurve(Gtk.DrawingArea):
    """What Shadows does to the picture: input brightness across, output up. The straight
    diagonal is an untouched picture; the curve bulges only at the dark end."""

    def __init__(self):
        super().__init__()
        self.level = 0
        self.set_size_request(44, 34)
        self.set_valign(Gtk.Align.CENTER)
        self.connect("draw", self.on_draw)

    def set_level(self, level):
        self.level = level
        self.queue_draw()

    def on_draw(self, w, cr):
        fg, sel = theme_colours(w)
        W, H = w.get_allocated_width() - 2, w.get_allocated_height() - 2
        cr.set_line_width(1)
        cr.set_source_rgba(fg.red, fg.green, fg.blue, .25)
        cr.move_to(1, H + 1)
        cr.line_to(W + 1, 1)
        cr.stroke()
        cr.set_source_rgba(sel.red, sel.green, sel.blue, 1)
        cr.set_line_width(1.5)
        cr.move_to(1, H + 1)
        for i in range(1, 45):
            cr.line_to(1 + W * i / 44, 1 + H * (1 - min(shadow_curve(i / 44, self.level), 1)))
        cr.stroke()


class Screen:
    """One monitor as the panel knows it: identity, current values, what it can do."""

    def __init__(self, panel, mon):
        self.panel, self.mon = panel, mon
        self.values, self.maxes, self.caps = {}, {}, None
        self.is_main = mon.key == panel.config.get("ambient", {}).get("main_monitor")
        self.pinned = False
        self.target = None          # where automatic brightness wants it

    def display_name(self):
        return self.panel.config.get("names", {}).get(self.mon.key) or self.mon.model or self.mon.output or "Monitor"

    def has(self, feature):
        return feature in self.values and (self.caps is None or feature in self.caps)

    def snapshot(self):
        """Preset entry for this monitor: the values worth restoring."""
        return {f: self.values[f] for f in PROFILE_SET if self.has(f)}


class DeskMap(Gtk.DrawingArea):
    """The desk, drawn to scale, and the brightness control itself. Each screen is filled
    from the bottom as far as its brightness reaches, on the same notched scale as every
    other screen, with its level as a number in the middle. Drag a screen up or down, or
    scroll over it, to set it; click it to bring up its contrast and speaker below. The
    line across a screen is where automatic brightness wants it, so a screen set by hand
    shows the gap between the two."""

    GAP, PX_PER_NOTCH = 4, 7

    def __init__(self, panel, width):
        super().__init__()
        self.panel, self.width = panel, width
        self.series = stops()
        self.drag = None            # (screen, start y, start position, moved)
        self.set_tooltip_text("Drag a screen up or down, or scroll over it, to set its brightness.\n"
                              "Click it for contrast, speaker and power.\n"
                              "The line across a screen is where automatic brightness wants it.")
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                        Gdk.EventMask.BUTTON1_MOTION_MASK | Gdk.EventMask.SCROLL_MASK |
                        Gdk.EventMask.SMOOTH_SCROLL_MASK)
        self.connect("draw", self.on_draw)
        self.connect("button-press-event", self.pressed)
        self.connect("motion-notify-event", self.moved)
        self.connect("button-release-event", self.released)
        self.connect("scroll-event", self.scrolled)
        set_cursor(self, "ns-resize")
        self.fit()

    def placed(self):
        return [m for m in self.panel.monitors if m.placed]

    def fit(self):
        mons = self.placed()
        if not mons:
            self.set_size_request(self.width, 1)
            return
        x0, y0 = min(m.x for m in mons), min(m.y for m in mons)
        bw = max(m.x + m.w for m in mons) - x0
        bh = max(m.y + m.h for m in mons) - y0
        self.k = min(self.width / bw, 230 / bh)
        self.origin = (x0 - (self.width / self.k - bw) / 2, y0)
        self.set_size_request(self.width, round(bh * self.k))
        self.queue_draw()

    def rect(self, m):
        g = self.GAP / 2
        return ((m.x - self.origin[0]) * self.k + g, (m.y - self.origin[1]) * self.k + g,
                m.w * self.k - 2 * g, m.h * self.k - 2 * g)

    def screen_at(self, px, py):
        for m in self.placed():
            x, y, w, h = self.rect(m)
            if x <= px <= x + w and y <= py <= y + h:
                return self.panel.screen_for(m)
        return None

    def on_draw(self, widget, cr):
        fg, sel = theme_colours(widget)
        n = len(self.series) - 1
        for m in self.placed():
            x, y, w, h = self.rect(m)
            screen = self.panel.screen_for(m)
            cr.rectangle(x, y, w, h)
            cr.set_source_rgba(fg.red, fg.green, fg.blue, .055)
            cr.fill()
            if screen is None or BRIGHTNESS not in screen.values:
                draw_text(cr, widget, m.model or m.output, x + 7, y + 5, .85, alpha=.4)
                continue
            selected = screen is self.panel.selected
            frac = pos_of(screen.values[BRIGHTNESS], self.series) / n
            cr.rectangle(x, y + h * (1 - frac), w, h * frac)
            cr.set_source_rgba(fg.red, fg.green, fg.blue, .13)
            cr.fill()
            # the top of the fill is the level: give it an edge
            cr.set_line_width(1.5)
            cr.set_source_rgba(fg.red, fg.green, fg.blue, .75)
            ly = min(y + h - .75, max(y + .75, y + h * (1 - frac)))
            cr.move_to(x, ly)
            cr.line_to(x + w, ly)
            cr.stroke()
            # notches down the left edge, the same scale on every screen
            cr.set_line_width(1)
            cr.set_source_rgba(fg.red, fg.green, fg.blue, .3)
            for i in range(n + 1):
                ty = round(y + h * (1 - i / n)) + (.5 if i < n else -.5) * (1 if i else -1)
                cr.move_to(x, ty)
                cr.line_to(x + 3, ty)
            cr.stroke()
            if screen.target is not None:
                ty = round(y + h * (1 - pos_of(screen.target, self.series) / n)) + .5
                ty = min(y + h - .5, max(y + .5, ty))
                cr.set_source_rgba(sel.red, sel.green, sel.blue, 1)
                cr.set_dash([3, 2])
                cr.move_to(x, ty)
                cr.line_to(x + w, ty)
                cr.stroke()
                cr.set_dash([])
            if selected:
                cr.set_line_width(1.5)
                cr.set_source_rgba(sel.red, sel.green, sel.blue, 1)
                cr.rectangle(x + .75, y + .75, w - 1.5, h - 1.5)
                cr.stroke()
            name = screen.display_name()
            tw, th = draw_text(cr, widget, name, x + 8, y + 5, .85, bold=selected,
                               alpha=.85 if selected else .6)
            notes = [s for s in ("main" if screen.is_main else "", "pinned" if screen.pinned else "") if s]
            if notes:
                draw_text(cr, widget, " · ".join(notes), x + 8, y + 5 + th, .75,
                          rgba=sel if screen.pinned else None, alpha=1 if screen.pinned else .45)
            # the number rides on its level line (under it when the line is near the top)
            big = widget.create_pango_layout("0")
            desc = widget.get_pango_context().get_font_description().copy()
            desc.set_size(int(desc.get_size() * 1.9))
            big.set_font_description(desc)
            bh = big.get_pixel_size()[1]
            ny = ly - bh if ly - bh >= y + 34 else min(ly + 1, y + h - bh)
            draw_text(cr, widget, str(screen.values[BRIGHTNESS]), x + w / 2, ny, 1.9, bold=True, align=.5)

    # --- direct manipulation
    def set_position(self, screen, position):
        level = self.series[max(0, min(int(position), len(self.series) - 1))]
        if level != screen.values.get(BRIGHTNESS):
            self.panel.set_level(screen, BRIGHTNESS, level)

    def pressed(self, _w, event):
        screen = self.screen_at(event.x, event.y)
        if screen and BRIGHTNESS in screen.values and event.button == 1:
            self.drag = [screen, event.y, pos_of(screen.values[BRIGHTNESS], self.series), False]
        return True

    def moved(self, _w, event):
        if not self.drag:
            return True
        screen, y0, start, _moved = self.drag
        steps = round((y0 - event.y) / self.PX_PER_NOTCH)
        if steps:
            self.drag[3] = True
            # from between two notches the first step lands on the nearer one in that direction
            first = notch(start, 1 if steps > 0 else -1, self.series)
            self.set_position(screen, first + steps - (1 if steps > 0 else -1))
        elif self.drag[3]:
            self.set_position(screen, round(start))
        return True

    def released(self, _w, event):
        if self.drag:
            self.panel.select(self.drag[0])
        self.drag = None
        self.panel.refresh_ambient()
        return True

    def scrolled(self, _w, event):
        screen, step = self.screen_at(event.x, event.y), scroll_step(event)
        if screen and step and BRIGHTNESS in screen.values:
            self.set_position(screen, notch(pos_of(screen.values[BRIGHTNESS], self.series), step, self.series))
        return True


