        self.note_lbl.set_visible(bool(text))

    def place(self):
        # Open by the pointer (that is where the panel button is), kept inside its monitor.
        if self.win is None:
            return
        px, py = self.anchor
        display = Gdk.Display.get_default()
        geo = display.get_monitor_at_point(px, py).get_geometry()
        nat = self.win.get_preferred_size()[1]
        w, h = nat.width, nat.height
        x = min(max(px - w // 2, geo.x), geo.x + geo.width - w)
        y = max(py - h - 24, geo.y) if py > geo.y + geo.height / 2 else py + 24
        y = min(y, geo.y + geo.height - h)
        self.win.move(x, y)

    def close(self):
        if self.win is None:
            return
        self.win.destroy()
        self.win = None
        if self.ambient_tick:
            GLib.source_remove(self.ambient_tick)
            self.ambient_tick = None
        self.closed_at = time.monotonic()
        # Linger briefly so a write still in flight finishes and a quick re-click is seen.
        GLib.timeout_add(1500, lambda: self.release() or False)

    # --- monitors
    def detect(self, force=False):
        """Monitors from the cached bus map when every active output is in it, else ddcutil detect."""
        outputs = read_outputs()
        cache = load_json(os.path.join(CACHE, "buses.json"), {})
        keys = {o["key"] for o in outputs if o["key"]}
        if not force and cache and keys and keys <= set(cache):
            self.populate({k: cache[k] for k in keys}, outputs)
            return
        self.note("looking for monitors…")

        def found(out):
            if self.win is None:
                return
            ddc = parse_detect(out)
            if ddc:
                try:
                    save_json(os.path.join(CACHE, "buses.json"), {**cache, **ddc})
                except OSError:
                    pass
            self.populate(ddc, outputs)
        run_async(["ddcutil", "detect"], found)

    def populate(self, ddc, outputs):
        self.note("")
        self.monitors, self.screens = [], []
        by_key = {o["key"]: o for o in outputs if o["key"]}
        for key, d in ddc.items():
            o = by_key.get(key)
            bus = self.buses.setdefault(d["bus"], Bus(d["bus"]))
            self.monitors.append(Monitor(
                key, bus, (o and o["model"]) or d.get("model") or "", d.get("connector", ""),
                (o["x"], o["y"], o["w"], o["h"]) if o else None, o["name"] if o else ""))
        for o in outputs:                   # outputs without DDC still take their place on the desk
            if o["key"] not in ddc:
                self.monitors.append(Monitor(o["key"] or o["name"], None, o["model"], "",
                                             (o["x"], o["y"], o["w"], o["h"]), o["name"]))
        self.monitors.sort(key=lambda m: (not m.placed, m.x + m.w / 2, m.y + m.h / 2))
        for m in self.monitors:
            if m.bus is None:
                continue
            screen = Screen(self, m)
            self.screens.append(screen)
            self.load_caps(screen)
            feats = [f for f in READ_SET if screen.caps is None or f in screen.caps]
            m.bus.read(feats, lambda vals, maxes, s=screen: self.got_values(s, vals, maxes))
        if not self.screens:
            self.note("no DDC monitors found\n(DDC/CI may be off in a monitor's own menu)")
        self.map.fit()
        self.status_stamp = None
        self.select(next((s for s in self.screens if s.is_main), self.screens[0] if self.screens else None))
        self.refresh_ambient()

    def screen_for(self, mon):
        return next((s for s in self.screens if s.mon is mon), None)

    def load_caps(self, screen):
        path = screen.mon.caps_path()
        try:
            with open(path) as f:
                screen.caps = parse_caps(f.read())
            return
        except OSError:
            pass

        def got(text):
            caps = parse_caps(text)
            if not caps or screen not in self.screens:
                return
            try:
                os.makedirs(CACHE, exist_ok=True)
                with open(path, "w") as f:
                    f.write(text)
            except OSError:
                pass
            screen.caps = caps
            if screen is self.selected:
                self.select(screen)
        screen.mon.bus.capabilities(got)

    def got_values(self, screen, vals, maxes):
        if self.win is None or screen not in self.screens:
            return
        if self.busy():                    # never pull a control out from under the hand
            vals = {f: v for f, v in vals.items() if f not in (BRIGHTNESS, CONTRAST)}
        screen.values.update(vals)
        screen.maxes.update(maxes)
        self.values_changed()

    # --- the selected screen's details
    def select(self, screen):
        self.selected = screen
        for child in self.detail.get_children():
            child.destroy()
        self.controls = {}
        if screen is None:
            return
        head = Gtk.Box(spacing=6)
        name_btn = Gtk.Button(label=screen.display_name())
        name_btn.set_relief(Gtk.ReliefStyle.NONE)
        name_btn.get_style_context().add_class("mp-namebtn")
        name_btn.set_tooltip_text("Rename this monitor")
        name_btn.connect("clicked", lambda b: self.rename(screen, b))
        head.pack_start(name_btn, False, False, 0)
        where = " · ".join(x for x in (position_word(screen.mon, self.monitors),
                                       "main" if screen.is_main else "") if x)
        where_lbl = dim_label(where)
        where_lbl.set_tooltip_text(screen.mon.output)
        head.pack_start(where_lbl, False, False, 0)
        if screen.caps is None or POWER in screen.caps:
            head.pack_end(link_button("turn off", "Switches this monitor off (DDC power mode). "
                                      "Wake it with its own power button.",
                                      lambda *_: screen.mon.bus.write(POWER, 4)), False, False, 0)
        self.pin_btn = link_button("pinned · unpin", "You set this screen by hand, so it stays there.\n"
                                   "Unpin to let it follow the light again.",
                                   lambda *_: self.control({"op": "release", "key": screen.mon.key}))
        self.pin_btn.set_no_show_all(True)
        head.pack_end(self.pin_btn, False, False, 8)
        self.detail.pack_start(head, False, False, 0)

        def line(text, feature):
            row = Gtk.Box(spacing=0)
            lbl = dim_label(text)
            lbl.set_size_request(64, -1)
            row.pack_start(lbl, False, False, 0)
            # A monitor whose firmware mishandles a remote setting (config.json "quirks"):
            # the HKC adds 78 to a contrast sent by the computer and lets it run past its
            # own menu's 100. Send only what stays inside the menu, and show the menu's number.
            quirk = self.config.get("quirks", {}).get(screen.mon.key, {}).get(feature, {})
            shift = quirk.get("shown_offset", 0)
            scale = StopScale(quirk.get("max", 100), fmt=lambda v: str(v + shift))
            if quirk:
                top = quirk.get("max", 100)
                scale.set_tooltip_text(
                    f"Shown as in this monitor's own menu. Its firmware only lets the computer set "
                    f"{shift}–{shift + top}; lower values exist only on the monitor's buttons.")
            scale.set_sensitive(False)
            scale.connect("value-changed", self.on_detail_scale, feature)
            self.controls[feature] = scale
            row.pack_start(scale, True, True, 0)
            self.detail.pack_start(row, False, False, 0)
            return row
        if screen.caps is None or CONTRAST in screen.caps:
            line("contrast", CONTRAST)
        if screen.caps and VOLUME in screen.caps:
            row = line("speaker", VOLUME)
            if MUTE in screen.caps:
                mute = Gtk.ToggleButton()
                mute.set_relief(Gtk.ReliefStyle.NONE)
                mute.get_style_context().add_class("mp-arrow")
                mute.add(icon("audio-volume-muted-symbolic", Gtk.IconSize.MENU))
                mute.set_tooltip_text("Mute")
                mute.connect("toggled", self.on_mute)
                row.pack_start(mute, False, False, 0)
                self.controls[MUTE] = mute
        foot = Gtk.Box(spacing=10)
        self.match_lbl = dim_label("")
        self.match_lbl.set_ellipsize(Pango.EllipsizeMode.END)
        foot.pack_start(self.match_lbl, False, False, 0)
        self.forget_btn = link_button("forget", "Drop what was remembered about how this screen compares to the main one",
                                      lambda *_: self.control({"op": "match", "forget": screen.mon.key}))
        self.forget_btn.set_no_show_all(True)
        foot.pack_start(self.forget_btn, False, False, 0)
        self.detail.pack_start(foot, False, False, 0)
        self.detail.show_all()
        self.status_stamp = None
        self.values_changed()
        if self.win is not None:
            self.refresh_ambient()

    def rename(self, screen, button):
        def done(text):
            names = self.config.setdefault("names", {})
            if text:
                names[screen.mon.key] = text
            else:
                names.pop(screen.mon.key, None)
            self.save_config()
            self.select(screen)
        EntryPopover(button, "Name for this monitor (empty = model name)", "Rename",
                     done, text=self.config.get("names", {}).get(screen.mon.key, "")).show()

    def on_detail_scale(self, scale, feature):
        if not self.guard and self.selected:
            level = scale.get_level()
            if level != self.selected.values.get(feature):
                self.set_level(self.selected, feature, level)

    def on_mute(self, btn):
        if not self.guard and self.selected:
            self.selected.values[MUTE] = 1 if btn.get_active() else 2
            self.selected.mon.bus.write(MUTE, self.selected.values[MUTE])

    # --- setting levels
    def set_level(self, screen, feature, level, tell=True):
        """Show a new level and send it. Brightness and contrast go through the brightness
        service when it runs: it is then the only writer, so nothing pushes an older value
        back, and it holds the level instead of steering back to automatic."""
        screen.values[feature] = level
        if feature in (BRIGHTNESS, CONTRAST) and self.automation_available():
            if tell:
                self.queue_control(screen.mon.key + feature, {
                    "op": "set", "key": screen.mon.key, "values": {feature: level}})
        elif screen.mon.bus:
            screen.mon.bus.write(feature, level)
        self.values_changed()

    def main_screen(self):
        return next((s for s in self.screens if s.is_main), None)

    def match_table(self):
        return self.ambient_status.get("match", {}) if self.automation_available() else {}

    def looks_like(self, screen, level):
        """The value on this monitor that looks like `level` on the main one."""
        return level if screen.is_main else matched(level, self.match_table().get(screen.mon.key))

    def remember_match(self, *_):
        main = self.main_screen()
        if main is None or BRIGHTNESS not in main.values:
            return
        self.control({"op": "match", "level": main.values[BRIGHTNESS], "points": {
            s.mon.key: s.values[BRIGHTNESS] for s in self.screens
            if not s.is_main and BRIGHTNESS in s.values}})

    def on_all(self, scale):
        if self.guard:
            return
        level = scale.get_level()
        table = {}
        for screen in self.screens:
            if BRIGHTNESS in screen.values:
                table[screen.mon.key] = self.looks_like(screen, level)
                self.set_level(screen, BRIGHTNESS, table[screen.mon.key], tell=False)
        if table and self.automation_available():
            self.queue_control("all", {"op": "levelset", "monitors": table})
        self.values_changed(from_all=True)

    def on_shadows(self, scale):
        self.tone.set_level(scale.get_level())
        if not self.guard:
            self.queue_control("shadows", {"op": "shadows", "value": scale.get_level()})

    def levels(self):
        """The four anchors of the day curve: being edited, from the service, or the defaults."""
        return self.local_levels or {**LEVELS, **self.ambient_status.get("levels", {})}

    def auto_level(self):
        return self.ambient_status.get("level") if self.automation_available() else None

    def on_anchor(self, phase, value):
        levels = dict(self.levels())
        levels[phase] = value
        i = PHASES.index(phase)
        for p in PHASES[:i]:                 # brighter light never means a darker screen:
            levels[p] = min(levels[p], value)       # neighbours move out of the way
        for p in PHASES[i + 1:]:
            levels[p] = max(levels[p], value)
        self.local_levels = levels
        for p, scrub in self.scrubs.items():
            scrub.show_value(levels[p])
        self.day.queue_draw()
        self.queue_control("levels", {"op": "levels", "values": levels})

    def values_changed(self, from_all=False):
        """Bring every drawing and control in line with the values, writing nothing."""
        if self.win is None:
            return
        known = [s.values[BRIGHTNESS] for s in self.screens if BRIGHTNESS in s.values]
        main = self.main_screen()
        self.guard = True
        try:
            self.all_scale.set_sensitive(bool(known))
            if known and not from_all:
                # All speaks the main monitor's scale when there is one, else the average.
                self.all_scale.set_level(main.values[BRIGHTNESS] if main and BRIGHTNESS in main.values
                                         else round(sum(known) / len(known)))
            screen = self.selected
            for feature, w in self.controls.items():
                known_here = screen is not None and feature in screen.values
                w.set_sensitive(known_here)
                if not known_here:
                    continue
                if isinstance(w, StopScale):
                    quirk = self.config.get("quirks", {}).get(screen.mon.key, {}).get(feature, {})
                    w.set_max(min(screen.maxes.get(feature, 100), quirk.get("max", 100)))
                    w.set_level(screen.values[feature])
                else:
                    w.set_active(screen.values[feature] == 1)
        finally:
            self.guard = False
        self.map.queue_draw()
        for chip, profile in self.chips:
            ctx = chip.get_style_context()
            (ctx.add_class if self.profile_matches(profile) else ctx.remove_class)("mp-on")

    # --- talking to the brightness service
    def automation_available(self):
        return bool(self.config.get("ambient", {}).get("enabled")) and \
            time.time() - self.ambient_status.get("updated_at", 0) < 120

    def busy(self):
        """True while a change of ours is on its way, or a screen is being dragged."""
        return bool(self.pending or self.inflight or (self.win and self.map.drag))

    def queue_control(self, subject, payload):
        """Latest value wins: while one request about a subject is in flight, newer ones
        replace each other and the last is sent as soon as the answer is back. A drag
        therefore reaches the monitor as fast as it can take it, and never out of order."""
        self.pending[subject] = payload
        if subject not in self.inflight:
            self.flush(subject)

    def flush(self, subject):
        self.inflight.add(subject)

        def after():
            self.inflight.discard(subject)
            if subject in self.pending:
                self.flush(subject)
        self.control(self.pending.pop(subject), after)

    def control(self, payload, after=None):
        if payload.get("op") in ("mode", "release", "match"):
            self.pending.clear()
        self.status_stamp = None          # take the service's answer even within the same round

        def done(result):
            if after:
                after()
            if self.win is None:
                return False
            self.request_error = result.get("error") or "; ".join(result.get("errors") or [])
            if payload.get("op") == "levels" and "levels" not in self.pending:
                self.local_levels = None
            self.refresh_ambient()
            return False

        def work():
            try:
                result = service_request(payload)
            except (OSError, ValueError, RuntimeError) as e:
                result = {"error": str(e) or "the brightness service is not answering"}
            GLib.idle_add(done, result)
        threading.Thread(target=work, daemon=True).start()

    def refresh_ambient(self):
        """Mode, sentence, pins, matches, the day curve and the Game control from the
        service's status file."""
        if self.win is None:
            return False
        status = load_json(str(STATUS), {})
        self.ambient_status = status
        alive = bool(status) and time.time() - status.get("updated_at", 0) <= 120
        managed = bool(self.config.get("ambient", {}).get("enabled"))
        self.mode_bar.set_visible(managed)
        self.mode_bar.set_sensitive(alive)
        self.day_box.set_visible(managed)
        self.day_box.set_sensitive(alive)
        self.day.queue_draw()
        if not self.local_levels:
            for phase, scrub in self.scrubs.items():
                scrub.show_value(self.levels()[phase])
        overrides = status.get("overrides", {}) if alive else {}
        main = status.get("main_monitor")
        mode = overrides.get(main, {}).get("mode", "auto")
        if mode not in self.mode_btns:
            mode = "auto"
        for m, b in self.mode_btns.items():
            ctx = b.get_style_context()
            (ctx.add_class if alive and m == mode else ctx.remove_class)("mp-on")
        pinned = {k for k, e in overrides.items() if e.get("mode") == "manual" or e.get("values")}
        level = status.get("level") if alive else None
        table = status.get("match", {}) if alive else {}
        for screen in self.screens:
            screen.pinned = screen.mon.key in pinned
            screen.target = None if level is None else self.looks_like(screen, level)
        self.all_scale.set_target(level)
        self.unpin_all.set_visible(len(pinned) > 1)
        self.match_btn.set_visible(alive and self.main_screen() is not None and len(self.screens) > 1)
        self.game_box.set_reveal_child(alive and mode == "game")
        sel = self.selected
        if sel is not None:
            self.pin_btn.set_visible(sel.pinned)
            points = table.get(sel.mon.key)
            if sel.is_main:
                text = "the other screens are matched to this one"
            elif points:
                text = "looks like main: " + ", ".join(f"{v} here = {l}" for l, v in points)
            else:
                text = "not matched to main yet"
            self.match_lbl.set_text(text if alive else "")
            self.forget_btn.set_visible(bool(points) and not sel.is_main)

        errors = [e for e in [self.request_error] + (status.get("errors") or []) if e]
        self.error_label.set_text(errors[0] if errors else "")
        self.error_label.set_visible(bool(errors))
        if not managed:
            self.ambient_label.set_text("Manual brightness")
            self.ambient_label.set_tooltip_text(None)
        elif not alive:
            self.ambient_label.set_text("Automatic brightness is not running · the controls still work")
            self.ambient_label.set_tooltip_text("systemctl --user status monitor-ambient")
        else:
            room = f"the light, {level}%" if level is not None else "the light"
            text = f"Following {room}" if mode == "auto" else \
                f"{mode.title()} on the main screen · the rest follow {room}"
            if any(not m.get("settled") for m in status.get("monitors", {}).values()) and not pinned:
                text += " · easing in"
            self.ambient_label.set_text(text)
            light = status.get("light", {})
            source = light.get("source", "Unknown light source")
            if "lux" in light:
                source += f", {light['lux']:.1f} lux"
            elif "radiation" in light:
                source += f", {light['radiation']:.0f} W/m²"
            self.ambient_label.set_tooltip_text(
                f"Light reading: {source} → {status.get('level_exact', level)}%\n"
                "Brightness glides between the four levels under the curve; contrast stays at 20%.\n"
                "Setting a screen by hand pins it until you unpin it.\n"
                "Weather estimates: Open-Meteo (CC BY 4.0), https://open-meteo.com/")

            stamp = (status.get("updated_at"), status.get("requested_revision"))
            if stamp != self.status_stamp and not self.busy():
                if not status.get("pending"):
                    for screen in self.screens:
                        actual = status.get("monitors", {}).get(screen.mon.key, {}).get("values")
                        if actual:
                            screen.values.update(actual)
                self.guard = True
                try:
                    self.shadow_scale.set_level(status.get("shadows", 40))
                finally:
                    self.guard = False
                self.status_stamp = stamp
        self.values_changed()
        return True

    # --- presets
    def profile_entry(self, profile, screen):
        return profile.get("monitors", {}).get(screen.mon.key) or profile.get("any")

    def profile_matches(self, profile):
        covered = False
        for screen in self.screens:
            entry = self.profile_entry(profile, screen)
            if not entry:
                continue
            covered = True
            for f, v in entry.items():
                if f in PROFILE_SET and screen.values.get(f) != v:
                    return False
        return covered

    def apply_profile(self, profile):
        entries = {s: self.profile_entry(profile, s) for s in self.screens if self.profile_entry(profile, s)}
        if self.automation_available():
            self.control({"op": "hold", "monitors": {s.mon.key: e for s, e in entries.items()}})
        for screen, entry in entries.items():
            for f in PROFILE_SET:
                if f in entry and (screen.caps is None or f in screen.caps):
                    self.set_level(screen, f, int(entry[f]), tell=False)
        self.values_changed()

    def build_profile_bar(self):
        for c in self.profile_bar.get_children():
            c.destroy()
        self.chips = []
        for profile in self.config["profiles"]:
            if profile.get("mode"):         # Movie/Game are modes now, not presets
                continue
            chip = Gtk.Button(label=profile["name"])
            chip.set_relief(Gtk.ReliefStyle.NONE)
            chip.get_style_context().add_class("mp-tab")
            chip.get_style_context().add_class("mp-preset")
            chip.set_tooltip_text("Apply this preset · right-click to rename, update or delete")
            chip.connect("clicked", lambda _b, p=profile: self.apply_profile(p))
            chip.connect("button-press-event", self.chip_pressed, profile)
            self.profile_bar.pack_start(chip, False, False, 0)
            self.chips.append((chip, profile))
        for chip, _p in self.chips:
            chip.show()
        self.profile_bar.set_visible(bool(self.chips))

    def add_profile(self, btn):
        def done(name):
            if not name:
                return
            self.config["profiles"] = [p for p in self.config["profiles"] if p["name"] != name]
            self.config["profiles"].append({"name": name, "monitors": self.snapshot()})
            self.save_config()
            self.build_profile_bar()
            self.values_changed()
        EntryPopover(btn, "Save the current settings as", "Save", done).show()

    def snapshot(self):
        return {s.mon.key: s.snapshot() for s in self.screens if s.snapshot()}

    def chip_pressed(self, chip, event, profile):
        if event.button != 3:
            return False

        def rename(name):
            if name:
                profile["name"] = name
                self.save_config()
                self.build_profile_bar()
                self.values_changed()

        def update():
            profile.pop("any", None)
            profile["monitors"] = self.snapshot()
            self.save_config()
            self.values_changed()

        def delete():
            self.config["profiles"].remove(profile)
            self.save_config()
            self.build_profile_bar()
        EntryPopover(chip, "Preset name", "Rename", rename, text=profile["name"],
                     extra=[("Update with the current settings", update),
                            ("Delete this preset", delete)]).show()
        return True


